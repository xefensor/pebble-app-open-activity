{
  "name": "pebble-app-open-activity",
  "version": "0.3.3",
  "author": "Xef",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "description": "One Quick Launch app for Dynamic or Halftone's recently displayed primary or secondary activity.",
  "scripts": {
    "test": "node --test tests/*.test.js && python3 scripts/test-native.py && npm run test:workflow && npm run check:docs && npm run test:release && python3 scripts/test-localization.py",
    "build": "python3 scripts/build.py",
    "check:artifact": "python3 scripts/check-artifact.py",
    "build:release": "python3 scripts/build.py --release",
    "test:workflow": "python3 -m unittest discover -s tests -p test_development_workflow.py",
    "test:source": "node --test tests/*.test.js && python3 scripts/test-native.py",
    "check:config": "node scripts/generate-config.cjs --check",
    "release:source": "python3 scripts/package-source.py",
    "check:docs": "python3 scripts/check-docs.py",
    "release:prepare": "python3 scripts/github-release.py prepare",
    "release:publish": "python3 scripts/github-release.py publish",
    "test:release": "python3 -m unittest discover -s tests -p \"test_*release*.py\"",
    "check:setup": "python3 scripts/check-setup.py",
    "check:localization": "python3 scripts/generate-localization.py --check"
  },
  "pebble": {
    "displayName": "Open Activity",
    "uuid": "d2d0bf48-cf4c-42f6-8b5f-3657fb2de4e9",
    "sdkVersion": "3",
    "projectType": "native",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery"
    ],
    "watchapp": {
      "watchface": false
    },
    "capabilities": [
      "configurable"
    ],
    "configPage": "config.html",
    "usesPermissions": [
      "LaunchApps"
    ],
    "plugin": {
      "description": "Open Activity shortcut settings. No activity sources or action proxy.",
      "script": "plugin.js",
      "sources": [],
      "actions": []
    },
    "resources": {
      "media": [
        {
          "type": "font",
          "name": "FONT_BODY_22",
          "file": "fonts/RobotoCondensed-Bold.ttf",
          "characterRegex": "[\\u0020-\\u024F\\u2019\\u2026]",
          "extended": true
        },
        {
          "type": "font",
          "name": "FONT_BODY_24",
          "file": "fonts/RobotoCondensed-Bold.ttf",
          "characterRegex": "[\\u0020-\\u024F\\u2019\\u2026]",
          "extended": true
        },
        {
          "type": "font",
          "name": "FONT_BODY_26",
          "file": "fonts/RobotoCondensed-Bold.ttf",
          "characterRegex": "[\\u0020-\\u024F\\u2019\\u2026]",
          "extended": true
        },
        {
          "type": "raw",
          "name": "LOCALIZATION",
          "file": "localization.bin"
        }
      ]
    },
    "messageKeys": {
      "OA_OPERATION": 2000,
      "OA_SESSION": 2001,
      "OA_BUTTON": 2002,
      "OA_ROLE": 2003,
      "OA_DESTINATION": 2004,
      "OA_ELAPSED_MS": 2005,
      "OA_TICKET": 2006,
      "OA_GESTURE": 2007,
      "OA_THEME": 2008
    }
  },
  "devDependencies": {
    "terser": "5.46.0"
  },
  "dependencies": {
    "pebble-xoce-ui": "file:vendor/pebble-xoce-ui-0.1.1.tgz"
  }
}
